# ── UtsavAI Configuration ─────────────────────────────────────────────
# Create a .env file in the project root:
#   cp .env.example .env
#
# 1. Google Gemini API Key (Required for AI generation; get from https://aistudio.google.com)
#    If left empty or unset, UtsavAI automatically runs in local deterministic Demo Mode.
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Preferred Gemini Models (fallback chain in order of priority)
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite

# 3. Allowed Origins for same-origin guard (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# 4. Express Server Port (default: 8080)
PORT=8080

# 5. Node Environment (development | production | test)
NODE_ENV=development
